<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css?family=Source+Serif+Pro:400,600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Libre+Baskerville&display=swap" rel="stylesheet">
    <link href="diseño.css" rel="stylesheet">
    <title>Fútbol Ya · Panel</title>
</head>

<body>
    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar__brand">
                <img class="sidebar__brand-logo" src="C:\Users\leona\OneDrive\Desktop\Proyecto2026\FutbolyaMVC\wwwroot\images\FutbolYa.png" alt="Fútbol Ya">
            </div>

            <nav class="sidebar__nav">
                <ul class="menu">

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="reservas">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <path d="M4 4h16v16H4z" stroke-linejoin="round" opacity="0" />
                                    <path d="M14.5 4.5a2 2 0 0 1 3 3L8 17l-4 1 1-4z" stroke-linecap="round"
                                        stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="menu__label">Reservas</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="inventario">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <rect x="4" y="4" width="16" height="16" rx="1.5" />
                                    <path d="M8 9h8M8 12.5h8M8 16h5" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="menu__label">Inventario</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="canchas">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <rect x="3.5" y="6" width="17" height="12" rx="1" />
                                    <path d="M12 6v12M3.5 12h17" />
                                    <circle cx="12" cy="12" r="2.4" />
                                </svg>
                            </span>
                            <span class="menu__label">Canchas</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="productos">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <path d="M4 8l8-4 8 4-8 4-8-4z" stroke-linejoin="round" />
                                    <path d="M4 8v8l8 4 8-4V8" stroke-linejoin="round" />
                                    <path d="M12 12v8" />
                                </svg>
                            </span>
                            <span class="menu__label">Productos</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="ventas">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <path d="M3 4h2l1.6 10.2A2 2 0 0 0 8.6 16h8a2 2 0 0 0 2-1.7L20 7H6"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="9" cy="20" r="1.3" />
                                    <circle cx="17" cy="20" r="1.3" />
                                </svg>
                            </span>
                            <span class="menu__label">Ventas</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="estadisticas">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <path d="M4 20V10M11 20V4M18 20v-7" stroke-linecap="round" />
                                    <path d="M3 20h18" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="menu__label">Estadísticas</span>
                        </button>
                    </li>

                    <li class="menu__item">
                        <button class="menu__button" type="button" data-section="usuarios">
                            <span class="menu__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                    <circle cx="12" cy="8" r="3.4" />
                                    <path d="M5 20c0-3.6 3.1-6.2 7-6.2s7 2.6 7 6.2" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="menu__label">Usuarios</span>
                        </button>
                    </li>

                </ul>
            </nav>

            
            <img class="sidebar__watermark" src="C:\Users\leona\OneDrive\Desktop\Proyecto2026\FutbolyaMVC\wwwroot\images\F.png" alt="" aria-hidden="true">
        </aside>

        <!-- CONTENIDO -->
        <div class="content">

            <header class="topbar">
                <button class="topbar__logout" type="button">
                    <span class="topbar__logout-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                            <path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" stroke-linecap="round"
                                stroke-linejoin="round" />
                            <path d="M14 8l4 4-4 4M18 12H9" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span>Cerrar Sesión</span>
                </button>
            </header>

            
            <main class="stage" style="background-image: url('C:\Users\leona\OneDrive\Desktop\Proyecto2026\FutbolyaMVC\wwwroot\images\Fondo.png');">
            </main>

        </div>

    </div>

    <script>
        // Marca como activo el botón de menú en el que se hace clic.
        document.querySelectorAll('.menu__button').forEach((button) => {
            button.addEventListener('click', () => {
                document.querySelectorAll('.menu__button').forEach((b) => b.classList.remove('is-active'));
                button.classList.add('is-active');
            });
        });
    </script>
</body>

</html>