@model List<FutbolyaMVC.DTOs.MaterialResponse>
@{
    ViewData["Title"] = "Inventario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/materiales.css" asp-append-version="true">
}

<div class="productos-panel materiales-panel">
    <h1 class="productos-panel__title">Gestión de Inventario</h1>

    <div class="productos-toolbar">
        <div class="productos-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscar" placeholder="Buscar material...">
        </div>
    </div>

    <div class="productos-list" id="listaMateriales"></div>

    <button type="button" class="btn-anadir" id="btnAbrirAlta">+ Añadir Material</button>
</div>

<!-- Modal Alta / Edición -->
<div class="modal-overlay" id="modalForm" hidden>
    <div class="modal-box">
        <h2 id="modalFormTitulo">Nuevo Material</h2>
        <form id="formMaterial">
            <input type="hidden" id="materialId">

            <div class="form-group">
                <label for="campoNombre">Nombre</label>
                <input type="text" id="campoNombre" maxlength="80" required>
            </div>

            <div class="form-group">
                <label for="campoCantidad">Stock</label>
                <input type="number" id="campoCantidad" min="0" step="1" required>
            </div>

            <div class="modal-error" id="formError"></div>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" id="btnCancelarForm">Cancelar</button>
                <button type="submit" class="btn-guardar">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar baja -->
<div class="modal-overlay" id="modalBaja" hidden>
    <div class="modal-box">
        <h2>Eliminar Material</h2>
        <p class="modal-mensaje">¿Desea eliminar este material permanentemente?</p>
        <div class="modal-error" id="bajaError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarBaja">Cancelar</button>
            <button type="button" class="btn-confirmar-baja" id="btnConfirmarBaja">Eliminar</button>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
    // Datos iniciales renderizados por el servidor (List<MaterialResponse> del Controller)
    const materialesIniciales = @Html.Raw(Json.Serialize(Model ?? new List<FutbolyaMVC.DTOs.MaterialResponse>()));
</script>
<script src="~/js/materiales.js" asp-append-version="true"></script>
