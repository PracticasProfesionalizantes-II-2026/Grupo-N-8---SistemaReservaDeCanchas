@model FutbolYaMVC.DTOs.CanchaIndexViewModel
@{
    ViewData["Title"] = "Canchas";
}

@* Canchas y horarios llegan serializados desde el ViewModel; wwwroot/js/cancha.js toma el
   control desde acá para el listado, alta/edición, cambio de estado y horarios ofrecidos. *@

@section Styles {
    <link rel="stylesheet" href="~/css/cancha.css" asp-append-version="true">
}

<div class="canchas-panel">
    <h1 class="canchas-panel__title">Gestión de Canchas</h1>

    <div class="canchas-toolbar">
        <div class="canchas-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscarCancha" placeholder="Buscar cancha...">
        </div>
        <select id="selectFiltroEstado" class="canchas-filter">
            <option value="">Todas</option>
            <option value="Disponible">Disponibles</option>
            <option value="Mantenimiento">En Mantenimiento</option>
            <option value="Baja">Dadas de baja</option>
        </select>
    </div>

    <div class="canchas-list" id="listaCanchas"></div>

    <button type="button" class="btn-anadir" id="btnAbrirAltaCancha">+ Añadir Cancha</button>
</div>

<!-- Modal Alta / Edición -->
<div class="modal-overlay" id="modalFormCancha" hidden>
    <div class="modal-box">
        <h2 id="modalFormCanchaTitulo">Nueva Cancha</h2>
        <form id="formCancha">
            <input type="hidden" id="canchaId">

            <div class="form-group">
                <label for="campoDescripcion">Descripción</label>
                <input type="text" id="campoDescripcion" maxlength="120" required>
            </div>

            <div class="form-group">
                <label>Horarios habilitados</label>
                <div class="horarios-checklist" id="horariosChecklist"></div>
            </div>

            <div class="modal-error" id="formCanchaError"></div>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" id="btnCancelarFormCancha">Cancelar</button>
                <button type="submit" class="btn-guardar">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar baja -->
<div class="modal-overlay" id="modalBajaCancha" hidden>
    <div class="modal-box">
        <h2>Dar de baja Cancha</h2>
        <p class="modal-mensaje">¿Desea dar de baja esta cancha? Se conservará el historial de reservas asociadas.</p>
        <div class="modal-error" id="bajaCanchaError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarBajaCancha">Cancelar</button>
            <button type="button" class="btn-confirmar-baja" id="btnConfirmarBajaCancha">Dar de baja</button>
        </div>
    </div>
</div>

<div class="toast" id="toastCancha"></div>

<script>
    const canchasIniciales = @Html.Raw(Json.Serialize(Model.Canchas));
    const horariosCatalogo = @Html.Raw(Json.Serialize(Model.Horarios));
</script>
<script src="~/js/cancha.js" asp-append-version="true"></script>
