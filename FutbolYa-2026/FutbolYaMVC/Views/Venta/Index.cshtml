@model FutbolYaMVC.DTOs.VentaIndexViewModel
@{
    ViewData["Title"] = "Ventas";
}

@* Ventas y productos llegan serializados desde el ViewModel; wwwroot/js/ventas.js toma el
   control desde acá para el listado, el carrito de la nueva venta y la anulación/reactivación. *@

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true">
}

<div class="productos-panel ventas-panel">
    <h1 class="productos-panel__title">Lista de Ventas</h1>

    <div class="productos-toolbar">
        <div class="productos-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscar" placeholder="Buscar venta...">
        </div>
        <select id="selectFiltroEstado" class="productos-filter">
            <option value="">Todos los estados</option>
            <option value="activo">Activas</option>
            <option value="baja">Anuladas</option>
        </select>
        <input type="date" id="inputFiltroFecha" class="productos-filter">
    </div>

    <div class="productos-list ventas-list" id="listaVentas"></div>

    <button type="button" class="btn-anadir" id="btnAbrirVenta">Realizar una venta</button>
</div>

<!-- Modal Nueva venta -->
<div class="modal-overlay" id="modalNuevaVenta" hidden>
    <div class="modal-box modal-box--venta">
        <h2>Nueva venta</h2>

        <div class="venta-tabla-wrap">
            <table class="venta-tabla">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>SubTotal</th>
                        <th class="venta-tabla__th-acciones"></th>
                    </tr>
                </thead>
                <tbody id="cuerpoTablaVenta"></tbody>
                <tfoot>
                    <tr class="venta-tabla__total">
                        <td>Total</td>
                        <td id="totalCantidad">0</td>
                        <td></td>
                        <td id="totalMonto">$0</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="modal-error" id="ventaError"></div>

        <button type="button" class="btn-anadir-producto" id="btnAbrirAgregarProducto">+ Añadir Producto</button>

        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarVenta">Cancelar</button>
            <button type="button" class="btn-guardar" id="btnConfirmarVenta">Confirmar</button>
        </div>
    </div>
</div>

<!-- Submodal Agregar Producto a Venta -->
<div class="modal-overlay" id="modalAgregarProducto" hidden>
    <div class="modal-box">
        <h2>Agregar Producto a Venta</h2>

        <div class="form-group">
            <label for="selectProducto">Producto</label>
            <select id="selectProducto"></select>
        </div>

        <div class="form-group">
            <label for="campoCantidadItem">Cantidad</label>
            <input type="number" id="campoCantidadItem" min="1" step="1" value="1">
        </div>

        <div class="modal-error" id="agregarProductoError"></div>

        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarAgregarProducto">Cancelar</button>
            <button type="button" class="btn-guardar" id="btnConfirmarAgregarProducto">Confirmar</button>
        </div>
    </div>
</div>

<!-- Modal Ver Detalles -->
<div class="modal-overlay" id="modalDetalles" hidden>
    <div class="modal-box modal-box--venta">
        <h2 id="detallesTitulo">Venta</h2>

        <div class="venta-tabla-wrap">
            <table class="venta-tabla">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>SubTotal</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTablaDetalles"></tbody>
                <tfoot>
                    <tr class="venta-tabla__total">
                        <td>Total</td>
                        <td id="detallesTotalCantidad">0</td>
                        <td></td>
                        <td id="detallesTotalMonto">$0</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="modal-actions modal-actions--fin">
            <button type="button" class="btn-volver" id="btnVolverDetalles">Volver</button>
        </div>
    </div>
</div>

<!-- Modal Confirmar baja -->
<div class="modal-overlay" id="modalBaja" hidden>
    <div class="modal-box">
        <h2>Anular Venta</h2>
        <p class="modal-mensaje">¿Desea anular esta venta? El stock de los productos se restituirá y la venta podrá reactivarse más adelante.</p>
        <div class="modal-error" id="bajaError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarBaja">Cancelar</button>
            <button type="button" class="btn-confirmar-baja" id="btnConfirmarBaja">Anular Venta</button>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
    // Datos iniciales renderizados por el servidor
    const ventasIniciales = @Html.Raw(Json.Serialize(Model.Ventas));
    const productosIniciales = @Html.Raw(Json.Serialize(Model.Productos));
</script>
<script src="~/js/ventas.js" asp-append-version="true"></script>
