@model List<FutbolYaMVC.DTOs.ProductoResponse>
@{
    ViewData["Title"] = "Productos";
}

@* Lista de productos serializada desde el Model; wwwroot/js/productos.js toma el control
   desde acá para el listado, alta/edición y ajuste de stock. *@

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">
}

<div class="productos-panel">
    <h1 class="productos-panel__title">Gestión de Productos</h1>

    <div class="productos-toolbar">
        <div class="productos-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscar" placeholder="Buscar producto...">
        </div>
        <select id="selectFiltroTipo" class="productos-filter">
            <option value="">Todos</option>
            <option value="Bebida">Bebidas</option>
            <option value="Comida">Comidas</option>
        </select>
        <select id="selectFiltroEstado" class="productos-filter">
            <option value="">Todos los estados</option>
            <option value="activo">Activos</option>
            <option value="baja">Dados de baja</option>
        </select>
    </div>

    <div class="productos-list" id="listaProductos"></div>

    <button type="button" class="btn-anadir" id="btnAbrirAlta">+ Añadir Producto</button>
</div>

<!-- Modal Alta / Edición -->
<div class="modal-overlay" id="modalForm" hidden>
    <div class="modal-box">
        <h2 id="modalFormTitulo">Nuevo Producto</h2>
        <form id="formProducto">
            <input type="hidden" id="productoId">

            <div class="form-group">
                <label for="campoNombre">Nombre</label>
                <input type="text" id="campoNombre" maxlength="80" required>
            </div>

            <div class="form-group">
                <label for="campoTipo">Tipo</label>
                <select id="campoTipo" required>
                    <option value="Bebida">Bebida</option>
                    <option value="Comida">Comida</option>
                </select>
            </div>

            <!-- Stock solo se pide al crear; al editar se ajusta desde el botón
                 "Ajustar stock" (ver modalStock más abajo), no pisando el valor con este form. -->
            <div class="form-group" id="grupoCantidad">
                <label for="campoCantidad">Stock inicial</label>
                <input type="number" id="campoCantidad" min="0" step="1">
            </div>

            <div class="form-group">
                <label for="campoPrecio">Precio</label>
                <input type="number" id="campoPrecio" min="0" step="0.01" required>
            </div>

            <div class="modal-error" id="formError"></div>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" id="btnCancelarForm">Cancelar</button>
                <button type="submit" class="btn-guardar">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar baja -->
<div class="modal-overlay" id="modalBaja" hidden>
    <div class="modal-box">
        <h2>Eliminar Producto</h2>
        <p class="modal-mensaje">¿Desea eliminar este producto permanentemente?</p>
        <div class="modal-error" id="bajaError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarBaja">Cancelar</button>
            <button type="button" class="btn-confirmar-baja" id="btnConfirmarBaja">Eliminar</button>
        </div>
    </div>
</div>

<!-- Modal Ajustar stock -->
<div class="modal-overlay" id="modalStock" hidden>
    <div class="modal-box">
        <h2>Ajustar Stock</h2>
        <p class="modal-stock-actual">Stock actual: <strong id="stockActual">0</strong></p>
        <div class="stock-tipo-toggle">
            <button type="button" class="btn-stock-tipo btn-stock-tipo--activo" id="btnIngreso" data-tipo="ingreso">Ingreso (+)</button>
            <button type="button" class="btn-stock-tipo" id="btnEgreso" data-tipo="egreso">Egreso (−)</button>
        </div>
        <div class="form-group">
            <label for="campoAjusteCantidad">Cantidad</label>
            <input type="number" id="campoAjusteCantidad" min="1" step="1" required>
        </div>
        <p class="modal-stock-preview">Stock resultante: <strong id="stockPreview">0</strong></p>
        <div class="modal-error" id="stockError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarStock">Cancelar</button>
            <button type="button" class="btn-guardar" id="btnConfirmarStock">Guardar</button>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
    // Datos iniciales renderizados por el servidor (List<ProductoResponse> del Controller)
    const productosIniciales = @Html.Raw(Json.Serialize(Model ?? new List<FutbolYaMVC.DTOs.ProductoResponse>()));
</script>
<script src="~/js/productos.js" asp-append-version="true"></script>
