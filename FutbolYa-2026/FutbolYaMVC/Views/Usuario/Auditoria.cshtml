@model FutbolYaMVC.DTOs.AuditoriaIndexViewModel
@{
    ViewData["Title"] = "Auditoría";
}

@* Historial de auditoría y usuarios (para el filtro por DNI) serializados desde el ViewModel;
   wwwroot/js/auditoria.js filtra el listado y muestra el detalle de cada entrada. Solo lectura,
   solo Administrador. *@

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true">
}

<div class="productos-panel auditoria-panel">
    <div class="usuarios-panel__header">
        <h1 class="productos-panel__title">Historial de Auditoría</h1>
        <a class="btn-ver-auditoria" asp-controller="Usuario" asp-action="Index">Volver a Usuarios</a>
    </div>

    <div class="auditoria-toolbar">
        <div class="productos-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscarDni" placeholder="Buscar por DNI del usuario...">
        </div>
    </div>

    <div class="auditoria-table-wrap">
        <table class="auditoria-table">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody id="cuerpoTablaAuditoria"></tbody>
        </table>
    </div>
</div>

<!-- Modal Detalle -->
<div class="modal-overlay" id="modalDetalleAuditoria" hidden>
    <div class="modal-box modal-box--auditoria">
        <h2>Detalle del registro</h2>
        <div class="auditoria-detalle-body" id="cuerpoDetalleAuditoria"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCerrarDetalleAuditoria">Cerrar</button>
        </div>
    </div>
</div>

<script>
    const auditoriasIniciales = @Html.Raw(Json.Serialize(Model.Auditorias));
    const usuariosParaFiltro = @Html.Raw(Json.Serialize(Model.Usuarios));
</script>
<script src="~/js/auditoria.js" asp-append-version="true"></script>
