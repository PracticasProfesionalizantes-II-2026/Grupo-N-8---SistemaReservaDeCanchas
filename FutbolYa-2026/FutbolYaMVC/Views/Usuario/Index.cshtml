@model List<FutbolYaMVC.DTOs.UsuarioResponse>
@{
    ViewData["Title"] = "Usuarios";
}

@* Lista de usuarios serializada desde el Model; wwwroot/js/usuarios.js toma el control desde
   acá para el listado, alta/edición, reactivación y reseteo de contraseña. Solo Administrador. *@

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true">
}

<div class="productos-panel">
    <div class="usuarios-panel__header">
        <h1 class="productos-panel__title">Gestión de Usuarios</h1>
        <a class="btn-ver-auditoria" asp-controller="Usuario" asp-action="Auditoria">Ver auditoría</a>
    </div>

    <div class="productos-toolbar">
        <div class="productos-search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input type="text" id="inputBuscar" placeholder="Buscar usuario...">
        </div>
        <select id="selectFiltroRol" class="productos-filter">
            <option value="">Todos los roles</option>
            <option value="admin">Administrador</option>
            <option value="operador">Operador</option>
        </select>
        <select id="selectFiltroEstado" class="productos-filter">
            <option value="">Todos los estados</option>
            <option value="activo">Activos</option>
            <option value="baja">Dados de baja</option>
        </select>
    </div>

    <div class="productos-list" id="listaUsuarios"></div>

    <button type="button" class="btn-anadir" id="btnAbrirAlta">+ Añadir Usuario</button>
</div>

<!-- Modal Alta / Edición -->
<div class="modal-overlay" id="modalForm" hidden>
    <div class="modal-box">
        <h2 id="modalFormTitulo">Nuevo Usuario</h2>
        <form id="formUsuario">
            <input type="hidden" id="usuarioId">

            <div class="form-group">
                <label for="campoNombre">Nombre</label>
                <input type="text" id="campoNombre" maxlength="60" required>
            </div>
            <div class="form-group">
                <label for="campoApellido">Apellido</label>
                <input type="text" id="campoApellido" maxlength="60" required>
            </div>
            <div class="form-group">
                <label for="campoDni">DNI</label>
                <input type="text" id="campoDni" maxlength="8" required>
            </div>
            <div class="form-group">
                <label for="campoDireccion">Dirección</label>
                <input type="text" id="campoDireccion" maxlength="120">
            </div>
            <div class="form-group">
                <label for="campoCorreo">Correo</label>
                <input type="email" id="campoCorreo" maxlength="120" required>
            </div>
            <div class="form-group" id="grupoContraseña">
                <label for="campoContraseña">Contraseña temporal</label>
                <input type="password" id="campoContraseña" minlength="8">
            </div>
            <div class="form-group">
                <label for="campoRol">Rol</label>
                <select id="campoRol">
                    <option value="false">Operador</option>
                    <option value="true">Administrador</option>
                </select>
            </div>

            <div class="modal-error" id="formError"></div>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" id="btnCancelarForm">Cancelar</button>
                <button type="submit" class="btn-guardar">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmar baja -->
<div class="modal-overlay" id="modalBaja" hidden>
    <div class="modal-box">
        <h2>Eliminar Usuario</h2>
        <p class="modal-mensaje">¿Desea dar de baja a este usuario?</p>
        <div class="modal-error" id="bajaError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarBaja">Cancelar</button>
            <button type="button" class="btn-confirmar-baja" id="btnConfirmarBaja">Eliminar</button>
        </div>
    </div>
</div>

<!-- Modal Confirmar reseteo de contraseña -->
<div class="modal-overlay" id="modalReset" hidden>
    <div class="modal-box">
        <h2>Restablecer contraseña</h2>
        <p class="modal-mensaje">Se enviará un código de verificación al correo del usuario para que pueda definir una nueva contraseña. ¿Continuar?</p>
        <div class="modal-error" id="resetError"></div>
        <div class="modal-actions">
            <button type="button" class="btn-cancelar" id="btnCancelarReset">Cancelar</button>
            <button type="button" class="btn-guardar" id="btnConfirmarReset">Enviar</button>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
    const usuariosIniciales = @Html.Raw(Json.Serialize(Model ?? new List<FutbolYaMVC.DTOs.UsuarioResponse>()));
</script>
<script src="~/js/usuarios.js" asp-append-version="true"></script>
